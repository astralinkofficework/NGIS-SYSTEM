# NGIS Connected School ERP Platform — Environment Configuration Template
# Copy this file to .env and adjust variables for your deployment environment.

# Server Configuration
PORT=3000
HOST=127.0.0.1
DEBUG=False
SECRET_KEY=ngis-connected-erp-master-key-prod-2026

# Performance & In-Memory Caching (Rule 22)
ENABLE_CACHE=true
CACHE_TTL_SECONDS=300
CACHE_PROVIDER=memory

# Stateless Scalability & Load Balancing (Rule 29)
ENABLE_STATELESS_SESSIONS=true
SESSION_STORE=database

# Asset Delivery & Compression (Rules 10 & 11)
ENABLE_COMPRESSION=true
STATIC_CACHE_MAX_AGE=86400

# Database Connection Pooling & Timeouts (Rules 21 & 27)
DATABASE_PATH=academic.db
DB_POOL_SIZE=10
DB_TIMEOUT_SECONDS=10.0

# Observability & Request Tracing (Rules 23 & 30)
ENABLE_REQUEST_TRACING=true
SLOW_QUERY_THRESHOLD_MS=200
WEB_VITALS_REPORTING=true

